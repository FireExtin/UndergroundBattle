     assert!(r.game.stack.is_empty());assert_eq!(r.game.resources(0),4);assert_eq!(r.game.board(&from).unwrap().1.time_markers,0);assert_eq!(r.game.board(&to).unwrap().1.time_markers,2);assert_eq!(r.game.seed,u64::MAX-95);
