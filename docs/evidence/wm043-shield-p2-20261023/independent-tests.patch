+#[test]
+fn independent_wm043_two_shown_sources_each_consume_one_enemy_shield() {
+    let shown = ["WM043", "WM043", "JC125", "JC125"];
+    let mut g = shown_layout(true, shown);
+    let target = independent_wm043_paid_shields(&mut g, 2);
+    show(&mut g, shown);
+    for actor in [0, 1] {
+        assert_eq!(g.pending.as_ref().unwrap().seat, actor);
+        assert_eq!(g.pending.as_ref().unwrap().choice.kind, w::CHOICE);
+        choose(&mut g, vec![target.clone()]);
+    }
+    independent_wm043_record("enemy-shield-two-sources", serde_json::json!({
+        "after": &g, "target": target, "expectedShield": 0, "expectedLockMarkers": 0
+    }));
+    assert!(g.mystic_contest.is_none() && g.pending.is_none());
+    assert_eq!((g.board(&target).unwrap().1.shield,
+                g.board(&target).unwrap().1.lock_markers), (0, 0));
+}
