+#[test]
+fn independent_wm043_shown_friendly_shield_and_decline_do_not_consume() {
+    let shown = ["WM043", "JC125", "JC125", "JC125"];
+    for (owner, take) in [(0, true), (1, true), (2, false)] {
+        let mut g = shown_layout(true, shown);
+        let target = independent_wm043_paid_shields(&mut g, owner);
+        show(&mut g, shown);
+        assert!(g.pending.as_ref().unwrap().choice.options.iter().any(|o| o.id == target));
+        assert_eq!(g.board(&target).unwrap().1.shield, 2, "listing targets is read-only");
+        choose(&mut g, if take { vec![target.clone()] } else { vec![] });
+        assert!(g.mystic_contest.is_none() && g.pending.is_none());
+        assert_eq!((g.board(&target).unwrap().1.shield,
+                    g.board(&target).unwrap().1.lock_markers), (2, if take { 1 } else { 0 }));
+    }
+}
