+// Independent review: explicit legal layouts; shields come from an actual paid
+// BQ059 deployment, never from manually assigning the shield field. These are
+// narrow native checks, not a complete game or a browser acceptance test.
+fn independent_wm043_paid_shields(g: &mut Game, owner: usize) -> String {
+    g.begin_window(Window::Action(g.team(owner)));
+    fund(g, owner, "CQ17", 7);
+    let id = held(g, "BQ059", owner);
+    let region = (0..g.regions.len()).find(|r| g.accessible(owner, *r)).unwrap();
+    act(g, owner, Action { card_id: Some(id), region: Some(region), ..Action::new("deploy") });
+    drain(g);
+    let id = g.regions[region].cards.iter()
+        .find(|c| c.definition == "BQ059" && c.controller == owner)
+        .unwrap().id.clone();
+    assert_eq!(g.board(&id).unwrap().1.shield, 2);
+    assert_eq!(g.board(&id).unwrap().1.lock_markers, 0);
+    g.begin_window(Window::Action(0));
+    id
+}
+
+fn independent_wm043_record(name: &str, value: serde_json::Value) {
+    if let Ok(dir) = std::env::var("INDEPENDENT_HISTORY_OUT") {
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(std::path::Path::new(&dir).join(format!("{name}.json")),
+            serde_json::to_vec_pretty(&value).unwrap()).unwrap();
+    }
+}
