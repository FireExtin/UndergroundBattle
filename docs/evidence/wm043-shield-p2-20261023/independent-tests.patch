+#[test]
+fn independent_wm043_room_shown_enemy_shield_finishes_and_rejects_duplicate() {
+    use crate::room::{RoomCommand, RoomEnvelope, SessionAction};
+    let shown = ["WM043", "JC125", "JC125", "JC125"];
+    let mut g = shown_layout(true, shown);
+    let target = independent_wm043_paid_shields(&mut g, 2);
+    show(&mut g, shown);
+    let room = RoomEnvelope::from_game(g);
+    let cmd = RoomCommand {
+        command_id: "independent-wm043-shown-shield".into(), expected_version: room.revision,
+        action: SessionAction::Game { action: Action {
+            choice_id: Some(room.game.pending.as_ref().unwrap().choice.id.clone()),
+            selected: Some(vec![target.clone()]), ..Action::new("choose")
+        } },
+    };
+    let first = room.transition(0, Some(cmd.clone()), 0).unwrap();
+    assert_eq!(first.outcome, "accepted", "shield ends only the targeted effect, not the command");
+    let after = RoomEnvelope::from_persisted(&first.state).unwrap();
+    let duplicate = after.transition(0, Some(cmd.clone()), 0).unwrap();
+    assert_eq!(duplicate.outcome, "rejected");
+    assert!(!duplicate.changed && duplicate.journal.is_empty());
+    assert_eq!(serde_json::to_value(RoomEnvelope::from_persisted(&duplicate.state).unwrap()).unwrap(),
+               serde_json::to_value(&after).unwrap());
+    independent_wm043_record("enemy-shield-room", serde_json::json!({
+        "before": &room, "command": &cmd, "first": &first, "duplicate": &duplicate,
+        "expectedShield": 1, "expectedLockMarkers": 0
+    }));
+    assert!(after.game.mystic_contest.is_none() && after.game.pending.is_none());
+    assert_eq!((after.game.board(&target).unwrap().1.shield,
+                after.game.board(&target).unwrap().1.lock_markers), (1, 0));
+}
