+#[test]
+fn independent_wm043_shown_enemy_shield_matches_paid_lock_guard() {
+    let shown = ["WM043", "JC125", "JC125", "JC125"];
+    let mut g = shown_layout(true, shown);
+    let target = independent_wm043_paid_shields(&mut g, 2);
+    let paid = spell(&mut g, 0);
+    act(&mut g, 0, action(&paid, "lock", &target));
+    pass_top(&mut g);
+    assert_eq!((g.board(&target).unwrap().1.shield,
+                g.board(&target).unwrap().1.lock_markers), (1, 0));
+    g.begin_window(Window::Action(0));
+    show(&mut g, shown);
+    let before = serde_json::to_value(&g).unwrap();
+    choose(&mut g, vec![target.clone()]);
+    independent_wm043_record("enemy-shield-game", serde_json::json!({
+        "before": before, "target": target, "after": &g,
+        "expectedShield": 0, "expectedLockMarkers": 0
+    }));
+    assert!(g.mystic_contest.is_none() && g.pending.is_none());
+    assert_eq!((g.board(&target).unwrap().1.shield,
+                g.board(&target).unwrap().1.lock_markers), (0, 0),
+               "printed p18 shield must terminate the targeted enemy shown-card effect");
+}
